CROSS JOIN (SELECT DISTINCT semester FROM exam_slots) sem
CROSS JOIN generate_series(0, 5) j
JOIN courses c ON c.timetable_no - 1 = ((st.s % 12 + 2 * j) % 12) + 12 * ((st.s / 12 + j) % 3);
